{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-gemma/gemma-4-26b",
  "share": "disabled",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "env": [],
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "omlx"
      },
      "models": {
        "qwen3-coder": {
          "id": "Qwen2.5-Coder-14B-Instruct-4bit",
          "name": "Qwen2.5 Coder 14B",
          "tool_call": true,
          "attachment": false,
          "temperature": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    },
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "env": [],
      "options": {
        "baseURL": "http://127.0.0.1:11444/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3-coder": {
          "name": "Qwen3-Coder-30B-A3B",
          "tool_call": true,
          "attachment": false,
          "temperature": true,
          "limit": {
            "context": 49152,
            "output": 8192
          }
        }
      }
    },
    "llama-gemma": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server Gemma (local)",
      "env": [],
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma-4-26b": {
          "name": "Gemma 4 26B A4B",
          "tool_call": true,
          "attachment": false,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "read": "allow",
    "webfetch": "ask",
    "external_directory": "deny"
  }
}
